# Copiá este archivo a .env.local y completá los valores con los de TU PROPIO
# proyecto de Firebase y TU PROPIO proyecto de Neon (ninguno compartido con el
# proyecto original Simulador_Aprender).
# NUNCA subas .env.local al control de versiones ni compartas estas claves.

# ---------------------------------------------------------------------------
# Firebase — proyecto NUEVO, usado solo para Auth (ninguna tabla de negocio
# vive acá; ver sección Neon más abajo).
# ---------------------------------------------------------------------------

# Firebase Console > Project settings > General > "Web API Key". No es
# secreta (Firebase la restringe por dominio/App Check, no por ocultarla),
# pero igual conviene no versionarla junto con el resto del repo.
NEXT_PUBLIC_FIREBASE_API_KEY=tu-web-api-key

# Firebase Console > Project settings > Service accounts > "Generate new
# private key" descarga un JSON con estos tres datos (SECRETOS, solo
# servidor; nunca los expongas al navegador).
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
# Pegá el valor de "private_key" del JSON tal cual (con los \n literales).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Neon — proyecto NUEVO, contiene todas las tablas de negocio (perfiles,
# cursos, preguntas, evaluaciones, intentos, etc). Dos connection strings
# distintas, de dos roles distintos:
# ---------------------------------------------------------------------------

# Rol de runtime ("app_runtime", creado a mano desde el panel de Neon:
# Project > Roles > Add role). Sujeto a Row Level Security. Es el único que
# usa la aplicación en producción/desarrollo normal.
DATABASE_URL=postgresql://app_runtime:tu-password@tu-proyecto.neon.tech/neondb?sslmode=require

# Rol administrador (el que Neon crea por defecto al crear el proyecto, dueño
# del esquema). Usado SOLO por scripts/apply-migrations.mjs y
# scripts/crear-primer-admin.mjs. Nunca lo uses en runtime de la app.
DATABASE_URL_ADMIN=postgresql://neondb_owner:tu-password@tu-proyecto.neon.tech/neondb?sslmode=require
