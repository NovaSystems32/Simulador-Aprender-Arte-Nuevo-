# Copiá este archivo a .env.local y completá los valores con los de TU PROPIO
# proyecto de Supabase y TU PROPIO proyecto de Neon (ninguno compartido con el
# proyecto original Simulador_Aprender).
# NUNCA subas .env.local al control de versiones ni compartas estas claves.

# ---------------------------------------------------------------------------
# Supabase — proyecto NUEVO y VACÍO, usado solo para Auth y Storage (ninguna
# tabla de negocio vive acá; ver sección Neon más abajo).
# ---------------------------------------------------------------------------

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Project Settings > API > Project API keys > service_role (SECRETA, solo servidor).
# Se usa únicamente para crear/borrar usuarios desde Server Actions (nunca para
# leer ni escribir tablas de negocio: esas viven en Neon).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------------------------------------------------------------------------
# Neon — proyecto NUEVO, contiene todas las tablas de negocio (perfiles,
# cursos, preguntas, evaluaciones, intentos, etc). Dos connection strings
# distintas, de dos roles distintos:
# ---------------------------------------------------------------------------

# Rol de runtime ("app_runtime", creado a mano desde el panel de Neon:
# Project > Roles > Add role). Sujeto a Row Level Security. Es el único que
# usa la aplicación en producción/desarrollo normal.
DATABASE_URL=postgresql://app_runtime:tu-password@tu-proyecto.neon.tech/neondb?sslmode=require

# Rol administrador (el que Neon crea por defecto al crear el proyecto, dueño
# del esquema). Usado SOLO por scripts/apply-migrations.mjs para correr las
# migraciones de db/migrations/. Nunca lo uses en runtime de la app.
DATABASE_URL_ADMIN=postgresql://neondb_owner:tu-password@tu-proyecto.neon.tech/neondb?sslmode=require
